;; Declared HERE and not only in deps.edn: the kbb engine reads nbb.edn and
;; does NOT resolve deps.edn :git/sha coordinates, so without this file
;; run_tests.kotoba cannot load kotoba.lang.text and the suite never runs.
;; sha values are COPIED from deps.edn -- keep the two in step.
{:paths ["src" "test"]
 :deps {io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "1f74cd29851edf11e8e6db8c7498c3086471f42b"
         :deps/root "lib/kotoba.text"}}}
